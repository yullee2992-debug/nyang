{
  "rules": {
    "users": {
      ".read": true,
      "$u": {
        ".write": true,
        ".validate": "newData.val() === null || newData.hasChildren(['name'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "coins": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10000000" }
      }
    },
    "cats": {
      ".read": true,
      "$c": {
        ".write": true,
        "name": { ".validate": "newData.isString() && newData.val().length <= 20" }
      }
    },
    "proposals": { ".read": true, "$p": { ".write": true } },
    "feed": {
      ".read": true,
      "$f": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['at','text']) && newData.child('text').isString() && newData.child('text').val().length <= 200"
      }
    }
  }
}
